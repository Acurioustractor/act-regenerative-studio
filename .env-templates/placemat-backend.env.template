# === SECURITY MONITORING ===
DEBUG_CORS=true
DEBUG_AUTH=true
DEBUG_API_KEYS=false
DEBUG_JWT=false
DEBUG_PERFORMANCE=true
ENABLE_SECURITY_METRICS=true

# === PERFORMANCE TUNING ===
CACHE_TIMEOUT=300000
AUTO_REFRESH_INTERVAL=300000
MAX_API_RETRIES=3
API_RETRY_DELAY=1000
