# ⚠️ SHARED ACROSS ALL ACT PROJECTS
# These variables are the SAME for all 4 projects
# Copy these into each project's .env.local file

# ==============================================
# NAS SERVICES (Synology DS420+ - 192.168.0.34)
# ==============================================
# These are automatically injected by dev-servers.mjs orchestrator
# Include them here for reference and manual deployment
REDIS_URL=redis://192.168.0.34:6379
CHROMADB_URL=http://192.168.0.34:8000

# ==============================================
# SHARED EMAIL SERVICE (Resend)
# ==============================================
# ✅ SAFE to use same API key across all projects
# Emails are differentiated by FROM address
RESEND_API_KEY=re_[your_shared_resend_api_key_here]

# ==============================================
# EMAIL SENDER ADDRESSES (Customize per project)
# ==============================================
# The Harvest:      EMAIL_FROM=hello@theharvest.org.au
# ACT Farm:         EMAIL_FROM=bookings@actfarm.org.au
# Empathy Ledger:   EMAIL_FROM=stories@empathyledger.com
# JusticeHub:       EMAIL_FROM=support@justicehub.org.au

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# DEVELOPMENT:
#   - NAS services available on local network (192.168.0.34)
#   - Use test/development API keys for all services
#
# PRODUCTION (Vercel):
#   - NAS services NOT available (cloud-only deployment)
#   - Use environment variables in Vercel dashboard
#   - Redis: Use Vercel KV or Upstash Redis
#   - ChromaDB: Use cloud-hosted instance or disable
