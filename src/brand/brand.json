    "_about": "Three moves only. Reference implementation (vanilla JS/CSS): ~/Documents/ACT_manifesto_assets/play/act-play.html. Respect prefers-reduced-motion everywhere.",
    "arrive": {
      "when": "something begins: first page of a visit (once per visit), end of every page, video end card",
      "ease": "cubic-bezier(.34,1.56,.64,1)",
      "durationMs": 700,
      "staggerMs": 120
    },
    "roll": {
      "when": "something moves: links (the arrow is the small wheel), reading progress (a small tractor), photos loading (the big wheel turns)",
      "linkMs": 600,
      "loadingSpinMs": 900
    },
    "unhitch": {
      "when": "something is handed on: a message sent, a story returned to its owner",
      "driveOffMs": 1400,
      "ease": "cubic-bezier(.55,0,.8,.2)"
    },
    "ease": "cubic-bezier(.65,0,.35,1)"
  },
