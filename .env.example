# ACT Main Website Environment Variables

# Anthropic AI API Key for Claude
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Optional legacy Notion snapshot backend (not required for the default site build)
NOTION_BACKEND_URL=http://localhost:4000
# Optional: fail fast when the legacy Notion snapshot backend is offline during manual sync
NOTION_BACKEND_FETCH_TIMEOUT_MS=1500

# Empathy Ledger URL + site-scoped syndication
EMPATHY_LEDGER_URL=http://localhost:3030
EMPATHY_LEDGER_SITE_SLUG=act-regenerative-studio
EMPATHY_LEDGER_API_KEY=your_empathy_ledger_site_api_key
EMPATHY_LEDGER_ORGANIZATION_ID=db0de7bd-eb10-446b-99e9-0f3b7c199b8a
# Optional: editorial syndication channel used for ACT journal/build snapshots
EMPATHY_LEDGER_EDITORIAL_DESTINATION=act_el
# Optional: skip live EL fetches during offline builds
EMPATHY_LEDGER_DISABLE_FETCH=false
# Optional: fail fast when EL is unavailable
EMPATHY_LEDGER_FETCH_TIMEOUT_MS=1500
# Optional: snapshot sync timeout for build-time EL media refresh
EMPATHY_LEDGER_SYNC_TIMEOUT_MS=8000

# Next.js Public Environment Variables
# (These are exposed to the browser)
NEXT_PUBLIC_EMPATHY_LEDGER_URL=https://empathyledger.com
NEXT_PUBLIC_SITE_URL=https://act.place

# Optional: Redis Cache (if using caching)
REDIS_URL=redis://192.168.0.34:6379

# Optional: ChromaDB for vector search
CHROMADB_URL=http://192.168.0.34:8000

# Notion Integration for ACT Projects
# Get your Notion integration token from: https://www.notion.so/my-integrations
# Share your databases with the integration
NOTION_TOKEN=ntn_xxx
NOTION_API_KEY=ntn_xxx
NOTION_PROJECTS_DATABASE_ID=177ebcf9-81cf-80dd-9514-f1ec32f3314c
NOTION_ACTIONS_DATABASE_ID=177ebcf9-81cf-8023-af6e-dff974284218
NOTION_PEOPLE_DATABASE_ID=47bdc1c4-df99-4ddc-81c4-a0214c919d69
NOTION_ORGANIZATIONS_DATABASE_ID=948f3946-7d1c-42f2-bd7e-1317a755e67b

# GHL Form Submission Databases (for webhook sync - issues #9, #12, #17, #20)
NOTION_PARTNERSHIPS_DATABASE_ID=xxx  # Contact/Partnership inquiries
NOTION_BOOKINGS_DATABASE_ID=xxx      # Farm stay bookings
NOTION_CSA_DATABASE_ID=xxx           # Harvest CSA member signups
NOTION_RESIDENCY_DATABASE_ID=xxx     # Art residency applications
NOTION_NEWSLETTER_DATABASE_ID=xxx    # Newsletter subscriptions

# AI Integrations
OPENAI_API_KEY=sk-proj-xxx
ANTHROPIC_API_KEY=sk-ant-api03-xxx
PERPLEXITY_API_KEY=pplx-xxx
GROQ_API_KEY=gsk_xxx
TAVILY_API_KEY=tvly-dev-xxx

# Gmail API (for knowledge extraction from emails)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Supabase (Shared with Empathy Ledger)
# Get credentials from: https://supabase.com/dashboard/project/tednluwflfhxyucgwigh/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tednluwflfhxyucgwigh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Empathy Ledger Enhanced (media import target)
# Get credentials from: https://supabase.com/dashboard/project/yvnuayzslukamizrlhwb/settings/api
EL_SUPABASE_URL=https://yvnuayzslukamizrlhwb.supabase.co
EL_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Webflow CMS API (for blog posts)
# Get your API token from: https://webflow.com/dashboard/account/integrations
# Get collection IDs from: https://webflow.com/api/docs
WEBFLOW_API_TOKEN=your_webflow_api_token
WEBFLOW_SITE_ID=your_webflow_site_id
WEBFLOW_BLOG_COLLECTION_ID=your_primary_blog_collection_id
WEBFLOW_BLOG_COLLECTION_ID_2=your_secondary_blog_collection_id

# Forms -> GHL routing (REQUIRED for /api/forms/submit to reach GHL)
# Every public form posts to /api/forms/submit, which forwards to this URL's
# /api/forms/submit (the act-ecosystem Command Center) for GHL contact + tagging.
# Local dev: the Command Center runs at http://localhost:3456.
# Production: must be a URL Vercel can reach (the Command Center is currently a
# localhost-only service, so prod has no reachable target -> submissions fall back
# to the Supabase `pending_form_submissions` table, which needs the Supabase vars
# below set in Vercel). See docs/strategy/act-website-review-2026-05-27.md.
ACT_ECOSYSTEM_API_URL=http://localhost:3456

# Supabase (REQUIRED in prod for the forms fallback queue + any runtime queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
