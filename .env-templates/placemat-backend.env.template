# === SHARED SERVICES (Auto-injected by orchestrator) ===
REDIS_URL=redis://192.168.0.34:6379
CHROMADB_URL=http://192.168.0.34:8000
RESEND_API_KEY=re_[your_shared_resend_api_key_here]
