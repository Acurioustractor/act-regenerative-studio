{
  "name": "act-main-website",
  "version": "1.0.0",
  "description": "A Curious Tractor - Main regenerative innovation studio website",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run sync:canon && npm run sync:wiki && npm run sync:project-codes && npm run sync:el-media && npm run sync:el-editorial && npm run sync:el-packets && npm run sync:el-storytellers && npm run sync:el-transcripts && next build",
    "sync:canon": "node scripts/sync-living-ecosystem-canon.mjs",
    "start": "next start",
    "lint": "next lint",
    "check:copy": "node scripts/check-public-copy.mjs",
    "sync:notion": "node scripts/sync-notion-projects.mjs",
    "sync:project-codes": "node scripts/sync-project-code-registry.mjs",
    "sync:el-media": "node scripts/sync-el-media.mjs",
    "sync:el-editorial": "node scripts/sync-el-editorial.mjs",
    "sync:el-packets": "node scripts/sync-el-source-packets.mjs",
    "sync:el-storytellers": "node scripts/sync-el-storytellers.mjs",
    "sync:el-transcripts": "node scripts/sync-el-transcripts.mjs",
    "seed:wiki-to-supabase": "node scripts/seed-wiki-to-supabase.mjs",
    "sync:wiki": "node scripts/sync-canonical-wiki-projects.mjs && node scripts/sync-canonical-wiki-pages.mjs && node scripts/sync-canonical-wiki-flagship-packs.mjs",
    "sync:wiki-projects": "node scripts/sync-canonical-wiki-projects.mjs",
    "sync:wiki-pages": "node scripts/sync-canonical-wiki-pages.mjs",
    "sync:wiki-flagship-packs": "node scripts/sync-canonical-wiki-flagship-packs.mjs",
    "media:audit": "node scripts/media-audit.mjs",
    "ask": "node scripts/ask-act.mjs",
    "dev:all": "node scripts/dev-servers.mjs",
    "start:ecosystem": "node scripts/dev-servers.mjs",
    "db:seed:alma": "npx ts-node scripts/seed_alma_real_initiatives.ts && npx ts-node scripts/seed_alma_contexts.ts && npx ts-node scripts/seed_alma_evidence.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@notionhq/client": "^5.6.0",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.89.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^169.0.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.562.0",
    "next": "15.5.15",
    "openai": "^6.15.0",
    "p-limit": "^7.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.17",
    "eslint": "^8",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
