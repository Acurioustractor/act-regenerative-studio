# ACT Ecosystem Admin Wiki - Environment Variables

# GoHighLevel (for fetching live data)
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_API_VERSION=2021-07-28

# Supabase (for admin auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis (shared NAS infrastructure)
REDIS_URL=redis://192.168.0.34:6379

# Admin Portal Settings
NEXT_PUBLIC_ADMIN_EMAILS=admin@actfarm.org.au,team@theharvest.org.au

# Optional: Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=admin.actstudio.org.au
