# GoHighLevel Integration
# Copy this file to .env.local and fill in your actual credentials
# Get these from: https://app.gohighlevel.com/ → Settings → Integrations → Private Integrations

# GHL API Key (Private Integration Token)
# Format: sk-live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GHL_API_KEY=your_ghl_api_key_here

# GHL Location ID (Sub-account ID)
# Format: loc_xxxxxxxxxxxx
# Find at: Settings → Business Profile
GHL_LOCATION_ID=your_location_id_here

# API Version (keep as is unless GHL updates)
GHL_API_VERSION=2021-07-28

# Optional: Pipeline IDs (configure after creating pipelines in GHL)
GHL_VOLUNTEER_PIPELINE_ID=
GHL_EVENT_BOOKING_PIPELINE_ID=
GHL_PARTNERSHIP_PIPELINE_ID=
GHL_TENANT_PIPELINE_ID=
GHL_CONTACT_WORKFLOW_ID=
GHL_TENANT_ONBOARDING_WORKFLOW_ID=

# NAS Services (shared infrastructure)
REDIS_URL=redis://192.168.0.34:6379
CHROMADB_URL=http://192.168.0.34:8000
