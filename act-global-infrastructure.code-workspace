  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.git": false,
      "**/dist": true,
      "**/.turbo": true,
      "**/.cursor": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/venv": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/venv": true
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "tailwindCSS.experimental.classRegex": [
      ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
      ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"]
    ]
  }
